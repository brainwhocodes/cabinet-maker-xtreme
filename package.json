{
  "name": "cabcraft-3d",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "biome check src app tests",
    "check:fix": "biome check --write src app tests",
    "lint:scss": "stylelint \"src/**/*.scss\" \"app/**/*.scss\"",
    "lint:scss:fix": "stylelint \"src/**/*.scss\" \"app/**/*.scss\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "react-doctor": "bun x react-doctor@latest --no-telemetry",
    "typecheck": "tsc --noEmit",
    "audit:all": "bun run check && bun run lint:scss && bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@iconify-icons/solar": "^2.0.1",
    "@iconify/react": "^6.0.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "bulma": "^1.0.4",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.103.1",
    "three": "0.180.0",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@biomejs/biome": "^2.5.11",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "0.180.0",
    "jsdom": "^30.0.1",
    "odiff-bin": "^4.5.0",
    "postcss": "^8.5.26",
    "postcss-scss": "^4.0.9",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
